worker_processes  auto;
error_log stderr warn;
pid /run/nginx.pid;

events {
    worker_connections  4096;
    use epoll;
    multi_accept on;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    log_format  main_timed  '$remote_addr - $remote_user [$time_local] "$request" '
                            '$status $body_bytes_sent "$http_referer" '
                            '"$http_user_agent" "$http_x_forwarded_for" '
                            '$request_time $upstream_response_time $pipe $upstream_cache_status';

    access_log /dev/stdout main_timed;
    error_log /dev/stderr notice;

    keepalive_timeout  65;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # Cache policy for static files. A URL with ?v=<cache buster> (asset() and
    # route('css.get') add it; it changes whenever the file does) may be kept
    # for good. One without has to be revalidated on every load: nginx sends
    # no Cache-Control by default, so browsers fell back to heuristic caching
    # (10% of the file's age) and kept old icons, module imports and images
    # for days after a deploy until the user cleared the cache by hand.
    map $arg_v $static_cache_control {
        ""       "no-cache";
        default  "public, max-age=31536000, immutable";
    }

    server {
        ${NGINX_LISTEN_IPV6_HTTP}
        listen ${NGINX_HTTP_PORT} default_server;
        ${NGINX_LISTEN_EXTRA_PORT}

        # Please note that return is cheaper than redirect
        # See: https://www.nginx.com/resources/wiki/start/topics/tutorials/config_pitfalls/#taxing-rewrites
        location / {
           return 301 https://$host$request_uri;
        }
    }

    server {
        ${NGINX_LISTEN_HTTPS_IPV4}
        ${NGINX_LISTEN_HTTPS_IPV6}
        ${NGINX_HTTP2_CONFIG}
        server_name ${NGINX_SERVER_NAME};

        # Use the internal DNS resolver of Docker
        resolver 127.0.0.11 valid=30s;

        root /var/www/html/public;

        ssl_certificate   /etc/nginx/certs/cert.pem;
        ssl_certificate_key /etc/nginx/certs/key.pem;

        # Filesize depending on your data (increased for database imports)
        client_max_body_size 500m;
        client_body_timeout 300s;
        
        ### SSL Configuration

        # set http headers for maximum security... as far as possible anyway.
        # Verify security (if applicable) afterwards with https://securityheaders.com/
        # It is recommended to cut out the following settings and include as file
        # Uncomment if applicable:
        # include /etc/nginx/conf-include/http.header.configuration.conf;
        ### HTTP Header security
        # Remove token
        server_tokens off;

        # Set CSP
        # Please note that CSP are very tricky and can be quite advanced to get right
        # For most optimal security however they are absolutely mandatory
        # There are ways to 'override' them for easier development
        # However they should be carefully evaluated, defined and included
        #add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' maps.googleapis.com www.googleoptimize.com; style-src 'self' 'unsafe-inline'; img-src 'self' 'unsafe-inline'; connect-src 'self' maps.googleapis.com" always;

        # Referrer Policy
        add_header Referrer-Policy same-origin;

        # Permissions Policy (modern standard, replaces deprecated Feature-Policy)
        # See W3C Document regarding setup: https://github.com/w3c/webappsec-permissions-policy/blob/master/permissions-policy-explainer.md
        #
        # Please check how to properly evaluate, define and include to your needs
        add_header Permissions-Policy "midi=(), sync-xhr=(), microphone=(self), camera=(), magnetometer=(), gyroscope=(), fullscreen=(self), payment=()";

        # set X-Frame-Options
        add_header X-Frame-Options "SAMEORIGIN" always;

        # set Xss-Protection
        add_header X-Xss-Protection "1; mode=block" always;

        # X-Content-Type-Options
        add_header X-Content-Type-Options "nosniff" always;

        location ^~ /storage {
            alias /var/www/html/storage/app/public;
        }

        # Fix MIME types for JavaScript files in build directory
        # This ensures PDF.js workers and other JS assets are served with correct MIME type
        location ~* ^/build/.*\.(js|mjs)$ {
            types {
                application/javascript js mjs;
            }
            default_type application/javascript;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        # Static files: explicit cache policy (see the $static_cache_control map).
        # add_header in a location drops the server-level headers, so the ones
        # that matter for assets are repeated here.
        location ~* \.(css|js|mjs|svg|png|jpe?g|gif|ico|webp|woff2?|ttf|eot|otf|map|json|wasm)$ {
            try_files $uri =404;
            add_header Cache-Control $static_cache_control;
            add_header X-Content-Type-Options "nosniff" always;
        }

        # Proxy S3 to MinIO (for browser direct uploads to bypass Mixed Content)
        location ^~ /s3/ {
            proxy_pass ${S3_ENDPOINT_URL}/;
            # MinIO requires the original Host header used for signing
            proxy_set_header Host ${S3_ENDPOINT_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # https upstreams (e.g. bucket-store) need SNI
            proxy_ssl_server_name on;
            client_max_body_size 500M;
        }

        # Laravel Reverb
        # The Websocket Client/Laravel Echo would connect and listen to this
        # Note: The reverbkey can contain special characters like colons (e.g., base64:...)
        # We need to capture and pass the entire key including any prefix
        location ~ ^/app/(.*)$ {
          proxy_pass http://reverb:8080/app/$1;
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection $connection_upgrade; # Use the mapped value
          proxy_set_header Host $host; # Use $host instead of $http_host sometimes needed
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme; # Ensure this is present
          proxy_set_header X-Forwarded-Host $host; # Good practice
          proxy_set_header X-Forwarded-Port $server_port; # Good practice
                      # Increase timeouts for long-lived connections
                      proxy_connect_timeout 2h;
                      proxy_send_timeout    2h;
                      proxy_read_timeout    2h;

                      # Disable buffering for real-time communication
                      proxy_buffering off;
        }

        # The Laravel Backend would broadcast to this
        # Note: The reverbid can contain special characters, match more precisely
        location ~ ^/apps/([^/]+)/events$ {
          proxy_pass http://reverb:8080/apps/$1/events;
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;
        }

		location / {
		    try_files $uri $uri/ /index.php?$query_string;
		    index index.php index.html index.htm;
		    location ~ .php$ {

		        fastcgi_pass   app:9000;
		        fastcgi_index  index.php;
		        fastcgi_param  SCRIPT_FILENAME  /var/www/html/public/index.php;
		        include        fastcgi_params;
		        
		        # Extended timeout for long-running AI operations (web search, reasoning)
		        fastcgi_read_timeout 600s;
		        fastcgi_send_timeout 600s;

		    }
		}

        # nginx Status
        # see: https://nginx.org/en/docs/http/ngx_http_stub_status_module.html
        location /nginx-status {
            allow 127.0.0.1;
            deny all;
            access_log off;
            stub_status;
        }
    }

    # =====================================================
    # Adminer (Database Management) - db.hawki.dev
    # =====================================================
    server {
        listen ${NGINX_HTTP_PORT};
        server_name db.hawki.dev;
        
        # Redirect HTTP to HTTPS
        return 301 https://$server_name$request_uri;
    }

    server {
        ${NGINX_LISTEN_HTTPS_IPV4}
        ${NGINX_LISTEN_HTTPS_IPV6}
        ${NGINX_HTTP2_CONFIG}
        server_name db.hawki.dev;
        
        ssl_certificate   /etc/nginx/certs/db.hawki.dev.crt;
        ssl_certificate_key /etc/nginx/certs/db.hawki.dev.key;
        
        # SSL configuration
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;
        ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
        
        # Allow large database imports
        client_max_body_size 500M;
        client_body_timeout 300s;
        
        # Reverse proxy to Adminer container
        location / {
            proxy_pass http://adminer:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # Timeouts
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }
    }

    # =====================================================
    # Mailpit (Email Testing - Dev Only) - mail.hawki.dev
    # =====================================================
    server {
        listen ${NGINX_HTTP_PORT};
        server_name mail.hawki.dev;
        
        # Redirect HTTP to HTTPS
        return 301 https://$server_name$request_uri;
    }

    server {
        ${NGINX_LISTEN_HTTPS_IPV4}
        ${NGINX_LISTEN_HTTPS_IPV6}
        ${NGINX_HTTP2_CONFIG}
        server_name mail.hawki.dev;
        
        ssl_certificate   /etc/nginx/certs/mail.hawki.dev.crt;
        ssl_certificate_key /etc/nginx/certs/mail.hawki.dev.key;
        
        # SSL configuration
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;
        ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
        
        # Reverse proxy to Mailpit container
        location / {
            proxy_pass http://mailpit:8025;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # WebSocket support for live updates
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            
            # Timeouts
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }
    }

    # =====================================================
    # Admin Portal (Dev Only) - admin.hawki.dev
    # =====================================================
    server {
        listen ${NGINX_HTTP_PORT};
        server_name admin.hawki.dev;
        
        # Redirect HTTP to HTTPS
        return 301 https://$server_name$request_uri;
    }

    server {
        ${NGINX_LISTEN_HTTPS_IPV4}
        ${NGINX_LISTEN_HTTPS_IPV6}
        ${NGINX_HTTP2_CONFIG}
        server_name admin.hawki.dev;
        
        # Use the internal DNS resolver of Docker
        resolver 127.0.0.11 valid=30s;

        root /var/www/html/public;

        ssl_certificate   /etc/nginx/certs/admin.hawki.dev.crt;
        ssl_certificate_key /etc/nginx/certs/admin.hawki.dev.key;
        
        # SSL configuration
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;
        ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;

        # Filesize depending on your data (increased for database imports)
        client_max_body_size 500m;
        client_body_timeout 300s;

        # Security headers
        server_tokens off;
        add_header Referrer-Policy same-origin;
        add_header Permissions-Policy "midi=(), sync-xhr=(), microphone=(self), camera=(), magnetometer=(), gyroscope=(), fullscreen=(self), payment=()";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Xss-Protection "1; mode=block" always;
        add_header X-Content-Type-Options "nosniff" always;

        location /storage {
            alias /var/www/html/storage/app/public;
        }

        # Fix MIME types for JavaScript files in build directory
        location ~* ^/build/.*\.(js|mjs)$ {
            types {
                application/javascript js mjs;
            }
            default_type application/javascript;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        # Proxy S3 to MinIO (for browser direct uploads to bypass Mixed Content)
        location ^~ /s3/ {
            proxy_pass ${S3_ENDPOINT_URL}/;
            # MinIO requires the original Host header used for signing
            proxy_set_header Host ${S3_ENDPOINT_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # https upstreams (e.g. bucket-store) need SNI
            proxy_ssl_server_name on;
            client_max_body_size 500M;
        }

        # Laravel Reverb WebSocket
        location ~ ^/app/(.*)$ {
          proxy_pass http://reverb:8080/app/$1;
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection $connection_upgrade;
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_set_header X-Forwarded-Host $host;
          proxy_set_header X-Forwarded-Port $server_port;
          proxy_connect_timeout 2h;
          proxy_send_timeout    2h;
          proxy_read_timeout    2h;
          proxy_buffering off;
        }

        location ~ ^/apps/([^/]+)/events$ {
          proxy_pass http://reverb:8080/apps/$1/events;
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            try_files $uri $uri/ /index.php?$query_string;
            index index.php index.html index.htm;
            location ~ .php$ {
                fastcgi_pass   app:9000;
                fastcgi_index  index.php;
                fastcgi_param  SCRIPT_FILENAME  /var/www/html/public/index.php;
                include        fastcgi_params;
                fastcgi_read_timeout 600s;
                fastcgi_send_timeout 600s;
            }
        }

        # nginx Status
        location /nginx-status {
            allow 127.0.0.1;
            deny all;
            access_log off;
            stub_status;
        }
    }
}
