# =====================================================
# HAWKI - ki-chat.uni-giessen.de (production host) env/.env additions
# =====================================================
# Prod runs the *staging* compose profile (containers hawki-staging-*, target
# app_staging), so env/.env.staging supplies the defaults and this is what the
# host's env/.env has to override or add on top of its existing values.
# Do NOT copy this file over env/.env — the host file carries APP_KEY, the
# *_SALT values, DB and LDAP settings that exist nowhere else. Merge it:
#   1. change the keys in section A in the existing env/.env
#   2. append section B (after filling in the real values)
# The prod inventory of 2026-09-04 found exactly the section-B keys missing.
# =====================================================

# ------------------------------------------------------------------
# A. Keys that already exist on the host and must CHANGE
# ------------------------------------------------------------------

# Pin the exact release, never :latest — update-staging.sh --pull would
# otherwise jump to whatever CI published last.
PROJECT_HAWKI_IMAGE=ghcr.io/stenseegel/hawki:2.3.2.1

# Keep! The data volumes are hawki-staging_mysql_data / hawki-staging_redis_data.
# Renaming the project starts the stack against an EMPTY database.
PROJECT_NAME=hawki-staging

# Must equal VITE_REVERB_APP_KEY baked into the image (.github/docker-build.prod.env).
REVERB_APP_KEY=hawki-reverb

# Optional service groups. Without the prod S3 bucket leave 'transcription' out;
# 'realtime' requires TURN_PASSWORD below (the deploy script enforces it).
#   COMPOSE_PROFILES=                      -> core stack only
#   COMPOSE_PROFILES=realtime              -> + realtime-bridge, coturn
#   COMPOSE_PROFILES=transcription,realtime -> full parity with ki-test
COMPOSE_PROFILES=realtime

# The redis service enforces --requirepass with this value since 2026-08.
# It exists on the host — verify it is NOT the placeholder 'password'.
#REDIS_PASSWORD=<existing real secret>

# Decision pending (prod ran APP_ENV=staging, APP_DEBUG=true, LOG_LEVEL=debug):
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=warning

# ------------------------------------------------------------------
# B. Keys missing on the host — append
# ------------------------------------------------------------------

# --- S3 (transcription uploads, audio-ingest). Dedicated PROD bucket on the
#     HRZ object store; never share ki-test's 'audio-ingest' bucket.
S3_ENDPOINT=https://bucket-store.hrz.uni-giessen.de:9001
S3_REGION=us-east-1
S3_DEFAULT_BUCKET=hawki-prod-audio
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Audio-ingest worker / transcription queues (stack-internal redis)
REDIS_AUDIO_INGEST_HOST=redis
REDIS_AUDIO_INGEST_DB=2
AUDIO_PREPROCESSING_QUEUE=audio_preprocessing_jobs
AUDIO_STATUS_QUEUE=audio_preprocessing_status
TRANSCRIPTION_QUEUE=transcription
TRANSCRIPTION_QUEUE_RETRY_AFTER=3900
TRANSCRIPTION_PROCESS_QUEUE=transcription_process
TRANSCRIPTION_PROCESS_QUEUE_RETRY_AFTER=7800

# --- TURN relay (coturn, TLS on 6443 — verified open to prod from off-campus).
#     The credential is handed to the browser by Laravel, so it is not a secret,
#     but it must not be empty or 'changeme'.
TURN_URLS=turns:ki-chat.uni-giessen.de:6443?transport=tcp
TURN_USERNAME=hawki
TURN_PASSWORD=
TURN_REALM=ki-chat.uni-giessen.de
TURN_TLS_PORT=6443
STUN_URLS=

# --- Proxy bypass: the app talks to the bridge via host.docker.internal and to the
#     gateway/object store inside .uni-giessen.de - both must NOT go through the
#     campus proxy, or Squid answers 503 (this bit prod on 2026-09-07).
DOCKER_NO_PROXY=localhost,127.0.0.1,reverb,file-converter,realtime-bridge,audio-ingest,redis,mysql,nginx,host.docker.internal,.uni-giessen.de

# --- Realtime bridge (host-networked; the app reaches it via host.docker.internal)
REALTIME_BRIDGE_URL=http://host.docker.internal:8089
REALTIME_BRIDGE_PORT=8089
REALTIME_BRIDGE_API_KEY=
PROJECT_REALTIME_BRIDGE_IMAGE=ghcr.io/stenseegel/hawki-realtime-bridge:latest
