# =====================================================
# HAWKI - Staging Environment Profile
# =====================================================
# This file contains ONLY the differences from .env.example
# for staging deployment.
#
# All shared configuration is in .env.example
# =====================================================

# Environment
APP_ENV=staging
APP_DEBUG=true
LOG_LEVEL=debug
LOG_CHANNEL=stack

# Project Configuration
PROJECT_NAME=hawki-staging
# Prebuilt by CI on every push to the `staging` branch of the app repo.
PROJECT_HAWKI_IMAGE=ghcr.io/stenseegel/hawki:staging

# Optional service groups (see compose/docker-compose.*.yml). Both enabled here;
# a host missing a prerequisite (S3 bucket, TURN credentials) narrows this in
# env/.env, e.g. COMPOSE_PROFILES=realtime or COMPOSE_PROFILES= (none).
COMPOSE_PROFILES=transcription,realtime

# Docker Configuration
DOCKER_PROJECT_IP=0.0.0.0

# Database Configuration
DB_EXTERNAL_PORT=3307
DB_DUMP_BINARY_PATH=/usr/bin

# Queue Configuration
QUEUE_CONNECTION=redis

# Redis Configuration
# The redis service now enforces this via --requirepass, and every client
# (Laravel, reverb, audio-ingest) authenticates with it — so this placeholder
# must be replaced with a real secret per deployment, not just "in production".
# The deployed value lives only in env/.env on the host, never in git.
REDIS_USERNAME=default
REDIS_PASSWORD=password

# Nginx Configuration
NGINX_SERVER_NAME=staging.hawki.dev
NGINX_ENABLE_IPV6=false
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Reverb Configuration
REVERB_HOST=staging.hawki.dev

# Docker User Mapping (use www-data for staging)
DOCKER_UID=33
DOCKER_GID=33

# Proxy Configuration (adjust for your network)
DOCKER_HTTP_PROXY=http://10.60.3.254:3128
DOCKER_HTTPS_PROXY=http://10.60.3.254:3128
DOCKER_NO_PROXY=localhost,127.0.0.1,reverb,file-converter,realtime-bridge,audio-ingest,redis,mysql,nginx,host.docker.internal,.uni-giessen.de


# Bucket credentials are host-only: set S3_ACCESS_KEY / S3_SECRET_KEY in env/.env
S3_ACCESS_KEY=
S3_SECRET_KEY=

S3_ENDPOINT=https://bucket-store.hrz.uni-giessen.de:9001
S3_DEFAULT_BUCKET=audio-ingest
# Stack-internal Redis — the audio-ingest worker runs in this stack now, and
# 134.176.150.177 (the old worker box) is firewalled off from ki-test entirely.
REDIS_AUDIO_INGEST_HOST=redis
# TURN relay for realtime WebRTC (coturn service). Required wherever the browser
# has no ICE candidate that can reach this host — e.g. VPN clients, where Chrome
# gathers candidates only on interfaces with no route here. The credential is
# handed to the browser by Laravel (ice-servers meta tag), so it is not secret;
# set a real value per deployment and prefer coturn REST credentials in prod.
TURN_URLS=turns:staging.hawki.dev:6443?transport=tcp
TURN_USERNAME=hawki
TURN_PASSWORD=changeme
