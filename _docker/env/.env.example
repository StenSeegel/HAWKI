# =====================================================
# HAWKI - Shared Environment Configuration
# =====================================================
# This file contains all shared configuration values
# that are common across all deployment profiles.
#
# Profile-specific overrides are loaded from:
# - .env.dev (development mode)
# - .env.staging (staging mode)
# - .env.prod (production mode)
#
# Use the initialization script to generate .env:
#   ./env-init.sh --profile=dev|staging|prod
# =====================================================

# -----------------------------------------------------
# Application Configuration
# -----------------------------------------------------
APP_NAME=HAWKI2
APP_URL=https://your-domain.com
APP_TIMEZONE="Europe/Berlin"
APP_LOCALE="de_DE"

# -----------------------------------------------------
# Encryption Keys (Auto-generated by env-init.sh)
# -----------------------------------------------------
# DO NOT share these keys or commit them to version control!
APP_KEY=
USERDATA_ENCRYPTION_SALT=
INVITATION_SALT=
AI_CRYPTO_SALT=
PASSKEY_SALT=
BACKUP_SALT=

# -----------------------------------------------------
# Database Configuration
# -----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hawki
DB_USERNAME=hawki
DB_PASSWORD=changeme
DB_DUMP_BINARY_PATH=/usr/bin

# -----------------------------------------------------
# Redis Configuration
# -----------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=changeme
CACHE_STORE=redis

# -----------------------------------------------------
# Logging
# -----------------------------------------------------
# stack = single (storage/logs/laravel.log) + database + stderr (docker logs).
# Plain 'stderr' would make container logs the ONLY sink — that's what made the
# transcription pipeline undiagnosable via laravel.log before.
LOG_CHANNEL=stack
LOG_STACK=single,database,stderr

# -----------------------------------------------------
# File Converter Service
# -----------------------------------------------------
FILE_CONVERTER=hawki_converter
# Converter >= 2.0 listens on port 80 inside the container (1.x used 8001)
HAWKI_FILE_CONVERTER_API_URL=http://file-converter/extract
HAWKI_FILE_CONVERTER_API_KEY=changeme

# Which file types a chat upload may be. The converter reports its own list
# (119 extensions on 3.0.2) and HAWKI takes it as it is, so a new document
# format needs no HAWKI change. Two filters sit on top:
#  - archives (zip, tar, gz, tgz, 7z, pst) are never accepted, hard-coded
#  - FILE_CONVERTER_EXCLUDED_EXTENSIONS is the admin deny list. Audio and video
#    are the default: the converter advertises them but its API answers 400, and
#    HAWKI transcribes media in the transcription module instead. Empty it once
#    the converter can transcribe.
# FILE_CONVERTER_EXCLUDED_EXTENSIONS=mp3,mpga,m4a,wav,webm,mp4,mpeg
# How long the list fetched from the converter is cached, in seconds.
# FILE_CONVERTER_FORMATS_CACHE_TTL=3600
# Largest chat upload in MB. A ceiling, not the effective limit: PHP's
# upload_max_filesize and post_max_size (both 256M in the app image) cap it and
# HAWKI shows whichever is smallest, so raising this beyond php.ini has no
# effect. Nginx allows 500M.
# HAWKI_ATTACHMENT_MAX_MB=256

# -----------------------------------------------------
# Page renderer (slide decks -> one image per slide)
# -----------------------------------------------------
# The converter never renders a slide, so a vision model saw a poster's icons
# cut out and could not place them. The page-render sidecar (LibreOffice +
# poppler) renders each slide and HAWKI sends those images instead of the
# extracted figures. Empty PAGE_RENDER_API_URL or PAGE_RENDER_ENABLED=false
# turns it off; a sidecar that is down leaves uploads as they were.
PAGE_RENDER_API_URL=http://page-render
PAGE_RENDER_API_KEY=
# Extensions rendered. PDF is deliberately not in the default: the converter
# already OCRs a PDF and extracts its figures, so rendering would send every
# picture twice. Add pdf when a PDF's layout matters more than that cost.
# PAGE_RENDER_FORMATS=pptx,ppt,pptm,ppsx,pps,potx,potm,pot,odp,otp,fodp,key
# PAGE_RENDER_MAX_PAGES=20
# PAGE_RENDER_DPI=110
# PAGE_RENDER_TIMEOUT=120
# PAGE_RENDER_REPLACE_FIGURES=true

# -----------------------------------------------------
# Nginx Configuration
# -----------------------------------------------------
# Note: NGINX_HTTP_PORT and NGINX_HTTPS_PORT are set in profile files
# - dev: 8080/8443 (internal ports, mapped to 80/443 by Docker)
# - staging/prod: 80/443 (standard ports)
NGINX_EXTRA_PORT=
NGINX_HTTP2_STYLE=new

# -----------------------------------------------------
# Broadcasting Configuration
# -----------------------------------------------------
BROADCAST_CONNECTION=reverb
BROADCAST_DRIVER=reverb

# -----------------------------------------------------
# Reverb WebSocket Server
# -----------------------------------------------------
REVERB_SERVER=reverb
REVERB_APP_ID=1001
REVERB_APP_KEY=hawki-reverb
REVERB_APP_SECRET=secret
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_MAX_MESSAGE_SIZE=250000

# -----------------------------------------------------
# Vite Frontend Configuration
# -----------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_APP_CLUSTER=mt1
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# -----------------------------------------------------
# Profile-Specific Configuration
# -----------------------------------------------------
# The following values will be set by the selected profile:
# - APP_ENV (local/staging/production)
# - APP_DEBUG (true/false)
# - LOG_LEVEL (debug/error)
# - PROJECT_NAME (hawki-dev/staging/prod)
# - PROJECT_HAWKI_IMAGE (Docker image to use)
# - DOCKER_PROJECT_IP (127.0.0.1 or 0.0.0.0)
# - NGINX_SERVER_NAME (domain name)
# - NGINX_ENABLE_IPV6 (true/false)
# - REVERB_HOST (same as NGINX_SERVER_NAME)
# - DOCKER_UID/GID (user mapping for Docker)
# - DOCKER_HTTP_PROXY (optional proxy configuration)
# - QUEUE_CONNECTION (database or redis)
# =====================================================
# -----------------------------------------------------
# Transcription / Audio Ingest Module
# -----------------------------------------------------
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_ENDPOINT=http://134.176.150.177:9000
S3_DEFAULT_BUCKET=audio-ingest
# Bucket for user uploads; activate with STORAGE_DISK=s3_files
S3_FILES_BUCKET=hawki-files
# STORAGE_DISK=s3_files
# Redis the audio-ingest worker shares with Laravel. Since the worker moved
# into this stack it is the stack's own Redis — must match the `audio-ingest`
# compose service's REDIS_HOST, or Laravel pushes preprocessing jobs to a Redis
# nobody consumes and `transcription:listen-status` blocks on a dead host.
REDIS_AUDIO_INGEST_HOST=redis

# Dedicated queue connections for the transcription pipeline (see
# _docker/docs/transcription/queue-dispatch.md). Both always use the database
# driver regardless of QUEUE_CONNECTION. retry_after must stay above the
# respective job's own timeout; only change these together with
# SPEACHES_DIARIZATION_TIMEOUT_CEILING.
# Phase 1 (AnalyzeSpeakersJob, speaker preview) — worker: queue-transcription
TRANSCRIPTION_QUEUE=transcription
TRANSCRIPTION_QUEUE_RETRY_AFTER=3900
# Phase 2 (ProcessTranscriptionJob, chunk transcription + final diarization)
# — worker: queue-transcription-process
TRANSCRIPTION_PROCESS_QUEUE=transcription_process
TRANSCRIPTION_PROCESS_QUEUE_RETRY_AFTER=7800