# Frontend (Vite) values baked into the STAGING image at CI build time.
# They must match env/.env on the staging host (ki-test) — the Reverb app key
# is a public client identifier (it ships in the browser JS), not a secret.
VITE_APP_NAME=HAWKI2
VITE_REVERB_APP_KEY=hawki-reverb
VITE_REVERB_HOST=ki-test.hrz.uni-giessen.de
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
