# Frontend (Vite) values baked into the PRODUCTION image at CI build time
# (builds trigger on v* tags). Set the real production hostname and Reverb app
# key BEFORE tagging the first production release — these are placeholders.
VITE_APP_NAME=HAWKI2
VITE_REVERB_APP_KEY=hawki-reverb
VITE_REVERB_HOST=hawki.uni-giessen.de
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
