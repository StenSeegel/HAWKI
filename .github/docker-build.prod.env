# Frontend (Vite) values baked into the PRODUCTION image at CI build time
# (builds trigger on v* tags, or a workflow_dispatch with profile=prod).
# They must match env/.env on the prod host (ki-chat) — the Reverb app key is a
# public client identifier (it ships in the browser JS), not a secret. If the
# host .env carries a different REVERB_APP_KEY, change the host to match the
# image, not the other way round.
VITE_APP_NAME=HAWKI2
VITE_REVERB_APP_KEY=hawki-reverb
VITE_REVERB_HOST=ki-chat.uni-giessen.de
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
