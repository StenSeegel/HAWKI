# We use the .env.example file as a base for the .env file.
# Everything you define here (or using the environment flags set in docker)
# will override the default values in the .env.example file.
# Please study the .env.example file for more information about the variables.

# Configuration for our docker-compose.yml
# Those variables SHOULD be kept as is, in order to work with the docker-compose.yml file.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
CACHE_STORE=redis
LOG_CHANNEL=stderr

# Optional variables you may adjust to your needs but MUST be set.
PROJECT_NAME=hawki-prod
PROJECT_HAWKI_IMAGE=digitalenvironments/hawki:latest
APP_ENV=production
APP_DEBUG=false
DB_USERNAME=hawki
DB_DATABASE=hawki
FILE_CONVERTER="hawki_converter"
HAWKI_FILE_CONVERTER_API_URL="http://file-converter:8001/extract"

# IMPORTANT VARIABLES YOU MUST SET TO SOMETHING ELSE!
APP_URL=https://your-domain.com # SET THIS TO YOUR DOMAIN!
DB_PASSWORD=changeme # SET THIS TO SOMETHING SECURE!
REDIS_PASSWORD=changeme # SET THIS TO SOMETHING SECURE!
APP_KEY= # Generate with: php artisan key:generate
USERDATA_ENCRYPTION_SALT= # Generate with: echo "base64:$(openssl rand -base64 32)"
INVITATION_SALT= # Generate with: echo "base64:$(openssl rand -base64 32)"
AI_CRYPTO_SALT= # Generate with: echo "base64:$(openssl rand -base64 32)"
PASSKEY_SALT= # Generate with: echo "base64:$(openssl rand -base64 32)"
BACKUP_SALT= # Generate with: echo "base64:$(openssl rand -base64 32)"
HAWKI_FILE_CONVERTER_API_KEY=changeme # SET THIS TO SOMETHING SECURE!

# Docker Build Proxy Configuration (for university network)
# Leave empty if no proxy is needed
DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=
DOCKER_NO_PROXY=localhost,127.0.0.1

# Nginx Configuration
# NGINX_SERVER_NAME: Domain name for the server (use '_' for wildcard)
# NGINX_HTTP_PORT: HTTP port (default: 80)
# NGINX_HTTPS_PORT: HTTPS port (default: 443)
# NGINX_EXTRA_PORT: Optional additional HTTP port (e.g., 3000, leave empty to disable)
# NGINX_ENABLE_IPV6: Enable IPv6 support (true/false)
# NGINX_HTTP2_STYLE: HTTP2 configuration style (new/old)
NGINX_SERVER_NAME=_
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_EXTRA_PORT=
NGINX_ENABLE_IPV6=false
NGINX_HTTP2_STYLE=new

# Add your own variables here
